<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="action_project_git_repository" model="ir.actions.act_window">
    <field name="name">Git Repositories</field>
    <field name="res_model">project.git.repository</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_project_git_delivery" model="ir.actions.act_window">
    <field name="name">Git Deliveries</field>
    <field name="res_model">project.git.delivery</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_project_git_branch" model="ir.actions.act_window">
    <field name="name">Git Branches</field>
    <field name="res_model">project.git.branch</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_project_git_commit" model="ir.actions.act_window">
    <field name="name">Git Commits</field>
    <field name="res_model">project.git.commit</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_project_git_pull_request" model="ir.actions.act_window">
    <field name="name">Git Pull Requests</field>
    <field name="res_model">project.git.pull.request</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_project_git_check" model="ir.actions.act_window">
    <field name="name">Git Checks</field>
    <field name="res_model">project.git.check</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_project_git_repository_list" model="ir.ui.view">
    <field name="name">project.git.repository.list</field>
    <field name="model">project.git.repository</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="provider" />
        <field name="project_id" />
        <field name="canonical_url" widget="url" />
        <field name="active" />
      </list>
    </field>
  </record>
  <record id="view_project_git_repository_search" model="ir.ui.view">
    <field name="name">project.git.repository.search</field>
    <field name="model">project.git.repository</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="provider" />
        <field name="project_id" />
        <filter string="Active" name="active" domain="[('active', '=', True)]" />
        <filter
          string="Provider"
          name="group_by_provider"
          context="{'group_by': 'provider'}"
        />
        <filter
          string="Project"
          name="group_by_project"
          context="{'group_by': 'project_id'}"
        />
      </search>
    </field>
  </record>
  <record id="view_project_git_repository_form" model="ir.ui.view">
    <field name="name">project.git.repository.form</field>
    <field name="model">project.git.repository</field>
    <field name="arch" type="xml">
      <form string="Git Repository">
        <header>
          <field
            name="active"
            widget="boolean_button"
            options="{'terminology': 'archive'}"
          />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              name="action_open_git_deliveries"
              type="object"
              class="oe_stat_button"
              icon="fa-inbox"
              groups="project.group_project_manager"
            >
              <field name="git_delivery_count" widget="statinfo" string="Deliveries" />
            </button>
            <button
              name="action_open_git_branches"
              type="object"
              class="oe_stat_button"
              icon="fa-code-fork"
            >
              <field name="git_branch_count" widget="statinfo" string="Branches" />
            </button>
            <button
              name="action_open_git_commits"
              type="object"
              class="oe_stat_button"
              icon="fa-code"
            >
              <field name="git_commit_count" widget="statinfo" string="Commits" />
            </button>
            <button
              name="action_open_git_pull_requests"
              type="object"
              class="oe_stat_button"
              icon="fa-code-review"
            >
              <field
                name="git_pull_request_count"
                widget="statinfo"
                string="Pull Requests"
              />
            </button>
            <button
              name="action_open_git_checks"
              type="object"
              class="oe_stat_button"
              icon="fa-check"
            >
              <field name="git_check_count" widget="statinfo" string="Checks" />
            </button>
          </div>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="provider" />
              <field name="provider_repository_id" />
              <field name="project_id" />
              <field name="company_id" readonly="1" />
            </group>
            <group>
              <field name="canonical_url" widget="url" />
              <field name="retention_policy" />
              <field name="webhook_secret_fingerprint" readonly="1" />
              <field name="webhook_secret" password="True" groups="base.group_system" />
            </group>
          </group>
          <p
            class="text-muted"
          >Git facts are provider observations, not evidence that an Odoo task is complete.</p>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_project_git_delivery_list" model="ir.ui.view">
    <field name="name">project.git.delivery.list</field>
    <field name="model">project.git.delivery</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="repository_id" />
        <field name="provider_delivery_id" />
        <field name="event_type" />
        <field name="state" />
        <field name="attempt_count" />
        <field name="next_retry_at" />
        <field name="received_at" />
      </list>
    </field>
  </record>
  <record id="view_project_git_delivery_form" model="ir.ui.view">
    <field name="name">project.git.delivery.form</field>
    <field name="model">project.git.delivery</field>
    <field name="arch" type="xml">
      <form string="Git Delivery" create="0" edit="0" delete="0">
        <sheet>
          <group>
            <group>
              <field name="repository_id" />
              <field name="provider" />
              <field name="provider_delivery_id" />
              <field name="event_type" />
              <field name="state" />
              <field name="attempt_count" />
            </group>
            <group>
              <field name="payload_sha256" />
              <field name="payload_size" />
              <field name="retained_until" />
              <field name="received_at" />
              <field name="processed_at" />
              <field name="next_retry_at" />
              <field name="last_error_at" />
              <field name="error_summary" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_project_git_branch_list" model="ir.ui.view">
    <field name="name">project.git.branch.list</field>
    <field name="model">project.git.branch</field>
    <field name="arch" type="xml">
