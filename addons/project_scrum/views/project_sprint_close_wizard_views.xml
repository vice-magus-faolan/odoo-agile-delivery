<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_project_sprint_close_wizard_form" model="ir.ui.view">
    <field name="name">project.sprint.close.wizard.form</field>
    <field name="model">project.sprint.close.wizard</field>
    <field name="arch" type="xml">
      <form string="Close Sprint">
        <group>
          <field name="sprint_id" invisible="1" />
          <field name="project_id" invisible="1" />
          <field name="company_id" invisible="1" />
          <field name="team_id" invisible="1" />
          <field name="unfinished_task_count" readonly="1" />
          <field name="unfinished_disposition" />
          <field
            name="target_sprint_id"
            invisible="unfinished_disposition != &apos;draft_sprint&apos;"
            required="unfinished_disposition == &apos;draft_sprint&apos;"
            domain="[(&apos;id&apos;, &apos;!=&apos;, sprint_id), (&apos;project_id&apos;, &apos;=&apos;, project_id), (&apos;company_id&apos;, &apos;=&apos;, company_id), (&apos;team_id&apos;, &apos;=&apos;, team_id), (&apos;state&apos;, &apos;=&apos;, &apos;draft&apos;)]"
          />
        </group>
        <footer>
          <button
            name="action_confirm"
            string="Close Sprint"
            type="object"
            class="btn-primary"
          />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
