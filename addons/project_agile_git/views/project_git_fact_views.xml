            <field name="url" widget="url" />
            <field name="ordering_state" />
            <field name="source_updated_at" />
            <field name="last_seen_at" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_project_git_commit_list" model="ir.ui.view">
    <field name="name">project.git.commit.list</field>
