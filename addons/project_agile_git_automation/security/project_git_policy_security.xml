<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="project_git_policy_audit_company_rule" model="ir.rule">
    <field name="name">Git Policy Audit: multi-company</field>
    <field name="model_id" ref="model_project_git_policy_audit" />
    <field name="domain_force">[("company_id", "in", company_ids)]</field>
  </record>
  <record id="project_git_policy_audit_visibility_rule" model="ir.rule">
    <field name="name">Git Policy Audit: Project visibility</field>
    <field name="model_id" ref="model_project_git_policy_audit" />
    <field
      name="domain_force"
    >[(1, "=", 1)] if user.has_group("project.group_project_manager") else ["|", ("repository_id.project_id.privacy_visibility", "in", ["employees", "portal"]), ("repository_id.project_id.message_partner_ids", "in", [user.partner_id.id])]</field>
  </record>
</odoo>
