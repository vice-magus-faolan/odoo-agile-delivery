#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

VERIFY_IMAGE_TAG=$(printf '%s' "$ROOT" | sha256sum | cut -d ' ' -f 1)
export VERIFY_IMAGE_TAG

WORKTREE_NAMESPACE=$(printf '%s' "$(basename "$ROOT")" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-')
# Always own a fresh disposable project; never adopt a development stack.
COMPOSE_PROJECT_NAME="odoo-agile-oca-verify-${WORKTREE_NAMESPACE%-}-$(date +%s%N)-$$"
export COMPOSE_PROJECT_NAME
COMPOSE=(docker compose -p "$COMPOSE_PROJECT_NAME" -f compose.oca-document-page.yaml)
DATABASE_INSTALL=odoo_agile_oca_document_page_install
DATABASE_UPGRADE=odoo_agile_oca_document_page_upgrade
DATABASE_REINSTALL=odoo_agile_oca_document_page_reinstall
MODULES=document_knowledge,document_page,document_page_project,project_agile,project_scrum,project_agile_document_page,project_scrum_document_page
TEST_TAGS=/document_knowledge,/document_page,/document_page_project,/project_agile,/project_scrum,/project_agile_document_page,/project_scrum_document_page
ADDONS_PATH=/usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons,/opt/oca-knowledge

source "$ROOT/scripts/lib/compose-teardown.sh"

chmod a+r "$ROOT/config/odoo.conf"
chmod -R a+rX "$ROOT/addons"
python3 -m compileall -q addons scripts
"${COMPOSE[@]}" config --quiet
"${COMPOSE[@]}" build odoo
"${COMPOSE[@]}" up -d --wait db

reset_verification_database() {
    "${COMPOSE[@]}" exec -T db dropdb -U odoo --if-exists "$1"
}

run_odoo() {
    "${COMPOSE[@]}" run --rm --no-deps odoo odoo \
        --config=/etc/odoo/odoo.conf \
        --addons-path="$ADDONS_PATH" \
        --stop-after-init \
        --without-demo=True \
        --log-level=test \
        "$@"
}

uninstall_module() {
    printf '%s\n' \
        "module = env['ir.module.module'].search([('name', '=', '$1')], limit=1)" \
        "module.button_immediate_uninstall()" \
        "env.cr.commit()" \
        | "${COMPOSE[@]}" run --rm --no-deps -T odoo odoo shell \
            --config=/etc/odoo/odoo.conf \
            --addons-path="$ADDONS_PATH" \
            -d "$DATABASE_REINSTALL" \
            --no-http
}

reset_verification_database "$DATABASE_INSTALL"
run_odoo --database "$DATABASE_INSTALL" --init "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf '%s\n' "OCA clean install and runtime contract passed for $MODULES."

reset_verification_database "$DATABASE_UPGRADE"
run_odoo --database "$DATABASE_UPGRADE" --init "$MODULES"
run_odoo --database "$DATABASE_UPGRADE" --update "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf '%s\n' "OCA upgrade smoke test passed for $MODULES."

reset_verification_database "$DATABASE_REINSTALL"
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES"
uninstall_module project_scrum_document_page
uninstall_module project_agile_document_page
uninstall_module project_scrum
uninstall_module project_agile
uninstall_module document_page_project
uninstall_module document_page
uninstall_module document_knowledge
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf '%s\n' "OCA uninstall/reinstall smoke test passed for $MODULES."
