  <record id="view_project_form_git_facts" model="ir.ui.view">
    <field name="name">project.project.form.git.facts</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project" />
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="agile_enabled" invisible="1" />
        <button
          name="action_open_git_repositories"
          type="object"
          class="oe_stat_button"
          icon="fa-code-fork"
          invisible="not agile_enabled"
        >
          <field name="git_repository_count" widget="statinfo" string="Repositories" />
        </button>
      </xpath>
    </field>
  </record>
  <record id="view_task_form_git_facts" model="ir.ui.view">
    <field name="name">project.task.form.git.facts</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="agile_project_enabled" invisible="1" />
        <button
          name="action_open_git_branches"
          type="object"
          class="oe_stat_button"
          icon="fa-code-fork"
          invisible="not agile_project_enabled"
        >
          <field name="git_branch_count" widget="statinfo" string="Branches" />
        </button>
        <button
          name="action_open_git_commits"
          type="object"
          class="oe_stat_button"
          icon="fa-code"
          invisible="not agile_project_enabled"
        >
          <field name="git_commit_count" widget="statinfo" string="Commits" />
        </button>
        <button
          name="action_open_git_pull_requests"
          type="object"
          class="oe_stat_button"
          icon="fa-code-review"
          invisible="not agile_project_enabled"
        >
          <field
            name="git_pull_request_count"
            widget="statinfo"
            string="Pull Requests"
          />
        </button>
        <button
          name="action_open_git_checks"
          type="object"
          class="oe_stat_button"
          icon="fa-check"
          invisible="not agile_project_enabled"
        >
          <field name="git_check_count" widget="statinfo" string="Checks" />
        </button>
      </xpath>
    </field>
  </record>

  <menuitem
    id="menu_project_git_repository"
    name="Git Repositories"
    parent="project.menu_project_management"
    action="action_project_git_repository"
    sequence="25"
  />
</odoo>
