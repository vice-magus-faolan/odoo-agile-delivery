<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_project_sprint_task_assignment_wizard_form" model="ir.ui.view">
    <field name="name">project.sprint.task.assignment.wizard.form</field>
    <field name="model">project.sprint.task.assignment.wizard</field>
    <field name="arch" type="xml">
      <form string="Sprint Backlog Operation">
        <group>
          <field name="task_ids" invisible="1" />
          <field name="project_id" invisible="1" />
          <field name="operation" readonly="1" />
          <field
            name="sprint_id"
            invisible="operation != &apos;assign&apos;"
            required="operation == &apos;assign&apos;"
            domain="[(&apos;project_id&apos;, &apos;=&apos;, project_id), (&apos;state&apos;, &apos;in&apos;, [&apos;draft&apos;, &apos;active&apos;])]"
          />
        </group>
        <footer>
          <button
            name="action_confirm"
            string="Apply"
            type="object"
            class="btn-primary"
          />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
