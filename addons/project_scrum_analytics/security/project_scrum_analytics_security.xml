<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_scrum_analytics_report_company_rule" model="ir.rule">
        <field name="name">Scrum analytics report company access</field>
        <field name="model_id" ref="model_project_scrum_analytics_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="project_scrum_analytics_timeline_company_rule" model="ir.rule">
        <field name="name">Scrum analytics timeline company access</field>
        <field name="model_id" ref="model_project_scrum_analytics_timeline"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
