#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
WORKTREE_NAMESPACE=$(printf '%s' "$(basename "$ROOT")" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-')
DEFAULT_COMPOSE_PROJECT_NAME="odoo-agile-verify-${WORKTREE_NAMESPACE%-}"
COMPOSE_PROJECT_NAME_WAS_SET=false
if [[ -v COMPOSE_PROJECT_NAME ]]; then
    COMPOSE_PROJECT_NAME_WAS_SET=true
fi
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$DEFAULT_COMPOSE_PROJECT_NAME}"
export COMPOSE_PROJECT_NAME
COMPOSE=(docker compose -f compose.yaml -f compose.verify.yaml)
DATABASE_INSTALL=odoo_agile_verify_install
DATABASE_UPGRADE=odoo_agile_verify_upgrade
DATABASE_REINSTALL=odoo_agile_verify_reinstall
VERIFICATION_DATABASES=("$DATABASE_INSTALL" "$DATABASE_UPGRADE" "$DATABASE_REINSTALL")
MODULES=project_agile,project_scrum,project_scrum_analytics,project_agile_ui,project_agile_git,project_agile_git_github,project_agile_git_automation,project_agile_solution
TEST_TAGS=/project_agile,/project_scrum,/project_scrum_analytics,/project_agile_ui,/project_agile_git,/project_agile_git_github,/project_agile_git_automation,/project_agile_solution

cleanup_verification_resources() {
    if [[ $COMPOSE_PROJECT_NAME_WAS_SET == false ]]; then
        "${COMPOSE[@]}" down --volumes --remove-orphans
    else
        printf "Preserving explicitly selected Compose project: %s\\n" "$COMPOSE_PROJECT_NAME" >&2
    fi
}

trap cleanup_verification_resources EXIT

chmod a+r "$ROOT/config/odoo.conf"
chmod -R a+rX "$ROOT/addons"
python3 -m compileall -q addons scripts
python3 -m unittest discover -s tests -p "test_*.py" -v
"${COMPOSE[@]}" config --quiet
"${COMPOSE[@]}" build odoo

wait_for_database() {
    for _ in $(seq 1 30); do
        "${COMPOSE[@]}" exec -T db pg_isready -U odoo -d postgres >/dev/null 2>&1 && return 0
        sleep 1
    done
    "${COMPOSE[@]}" exec -T db pg_isready -U odoo -d postgres
}

reset_verification_database() {
    local database=$1
    local configured_database

    for configured_database in "${VERIFICATION_DATABASES[@]}"; do
        if [[ $configured_database == "$database" ]]; then
            printf "%s\n" "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = :'database_name' AND pid <> pg_backend_pid();" \
                | "${COMPOSE[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U odoo -d postgres \
                    -v database_name="$database"
            "${COMPOSE[@]}" exec -T db dropdb -U odoo --if-exists "$database"
            return
        fi
    done

    printf "Refusing to reset undeclared verification database: %s\n" "$database" >&2
    return 2
}

run_odoo() {
    "${COMPOSE[@]}" run --rm odoo odoo --config=/etc/odoo/odoo.conf --stop-after-init --without-demo=True --log-level test "$@" 2>&1 \
        | python3 "$ROOT/scripts/check_solution_test_run.py" "$@"
}

uninstall_module() {
    printf "%s\n" \
        "module = env[\"ir.module.module\"].search([(\"name\", \"=\", \"$1\")], limit=1)" \
        "module.button_immediate_uninstall()" \
        "env.cr.commit()" \
        | "${COMPOSE[@]}" run --rm -T odoo odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_REINSTALL" --no-http
}

"${COMPOSE[@]}" up -d db
wait_for_database
reset_verification_database "$DATABASE_INSTALL"
run_odoo --database "$DATABASE_INSTALL" --init project_agile_git_automation --test-enable --test-tags /project_agile_git_automation
printf "%s\n" "Independent optional Git policy install passed (without GitHub or Scrum)."
reset_verification_database "$DATABASE_INSTALL"
run_odoo --database "$DATABASE_INSTALL" --init project_agile_solution --test-enable --test-tags /project_agile_solution
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/solution_source_probe.py"
printf "%s\n" "Independent optional solution install passed (without Scrum, Git, Sales or document backend)."
reset_verification_database "$DATABASE_INSTALL"
run_odoo --database "$DATABASE_INSTALL" --init "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf "%s\n" "Clean install passed for $MODULES."
"${COMPOSE[@]}" run --rm -T -v "$ROOT/scripts:/mnt/policy-tests:ro" odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/git_policy_concurrency_probe.py"
printf "%s\n" "Native Git policy scheduling, budget interruption, independent-process races and crash recovery passed."
"${COMPOSE[@]}" run --rm -T -v "$ROOT/scripts:/mnt/policy-tests:ro" odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/github_association_concurrency_probe.py"
printf "%s\n" "Current-delivery association proof and independent-process duplicate recovery passed."
reset_verification_database "$DATABASE_UPGRADE"
run_odoo --database "$DATABASE_UPGRADE" --init "$MODULES"
run_odoo --database "$DATABASE_UPGRADE" --update "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf "%s\n" "Upgrade smoke test passed for $MODULES."
reset_verification_database "$DATABASE_REINSTALL"
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES"
uninstall_module project_agile_solution
uninstall_module project_agile_git_automation
uninstall_module project_agile_git_github
uninstall_module project_agile_git
uninstall_module project_agile_ui
uninstall_module project_scrum_analytics
uninstall_module project_scrum
uninstall_module project_agile
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf "%s\n" "Uninstall/reinstall smoke test passed for $MODULES."
printf "%s\n" "Milestone 5 planning-board verification passed."
printf "%s\n" "Milestone 6 Git facts contract verification passed."
printf "%s\n" "Milestone 7 Git policy controls, dry-run, apply and recovery verification passed."
printf "%s\n" "Milestone 8 lineage/baseline lifecycle, native negative tests and independent allocation/approval races verified; full M8 remains downstream."
