<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_requirement_list" model="ir.ui.view">
    <field name="name">agile.requirement.list</field>
    <field name="model">project.agile.requirement</field>
    <field name="arch" type="xml">
      <list>
        <field name="key" />
        <field name="name" />
        <field name="solution_id" />
        <field name="project_id" />
        <field name="active" />
      </list>
    </field>
  </record>
  <record id="view_requirement_form" model="ir.ui.view">
    <field name="name">agile.requirement.form</field>
    <field name="model">project.agile.requirement</field>
    <field name="arch" type="xml">
      <form duplicate="0">
        <header>
          <button
            name="action_new_revision"
            type="object"
            string="Open or Create Content Revision"
            groups="project.group_project_manager,project_agile_solution.group_business_analyst"
          />
        </header>
        <sheet>
          <group>
            <field name="key" />
            <field name="name" />
            <field name="solution_id" readonly="id" />
            <field name="project_id" />
            <field name="active" />
          </group>
          <field name="revision_ids" readonly="1">
            <list>
              <field name="number" />
              <field name="title" />
              <field name="requirement_type" />
              <field name="sealed" />
            </list>
          </field>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <record id="view_requirement_revision_list" model="ir.ui.view">
    <field name="name">agile.requirement.revision.list</field>
    <field name="model">project.agile.requirement.revision</field>
    <field name="arch" type="xml">
      <list>
        <field name="requirement_id" />
        <field name="number" />
        <field name="title" />
        <field name="requirement_type" />
        <field name="priority" />
        <field name="sealed" />
      </list>
    </field>
  </record>
  <record id="view_requirement_revision_form" model="ir.ui.view">
    <field name="name">agile.requirement.revision.form</field>
    <field name="model">project.agile.requirement.revision</field>
    <field name="arch" type="xml">
      <form duplicate="0">
        <sheet>
          <div
            class="alert alert-info"
            role="status"
          >Requirement acceptance is separate from Task Done, PR merge and document approval. Referenced content is sealed; revise through the stable identity.</div>
          <group>
            <field name="requirement_id" readonly="id" />
            <field name="number" />
            <field name="predecessor_id" />
            <field name="sealed" />
            <field name="sealed_at" />
            <field name="sealed_by_id" />
            <field name="title" readonly="sealed" />
            <field name="requirement_type" readonly="sealed" />
            <field name="priority" readonly="sealed" />
            <field name="audience" readonly="sealed" />
          </group>
          <group>
            <field name="description" readonly="sealed" />
            <field name="rationale" readonly="sealed" />
            <field name="verification_method" readonly="sealed" />
            <field name="acceptance_expectations" readonly="sealed" />
          </group>
          <notebook>
            <page string="Exact Document References">
              <field name="document_revision_ids" readonly="1" />
            </page>
            <page string="Affected Context">
              <field name="context_revision_ids" readonly="1" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_context_list" model="ir.ui.view">
    <field name="name">solution.context.list</field>
    <field name="model">project.agile.solution.context</field>
    <field name="arch" type="xml">
      <list>
        <field name="key" />
        <field name="name" />
        <field name="kind" />
        <field name="solution_id" />
        <field name="project_id" />
        <field name="active" />
      </list>
    </field>
  </record>
  <record id="view_context_form" model="ir.ui.view">
    <field name="name">solution.context.form</field>
    <field name="model">project.agile.solution.context</field>
    <field name="arch" type="xml">
      <form duplicate="0">
        <header>
          <button
            name="action_new_revision"
            type="object"
            string="Open or Create Context Revision"
            groups="project.group_project_manager,project_agile_solution.group_business_analyst"
          />
        </header>
        <sheet>
          <group>
            <field name="key" />
            <field name="name" />
            <field name="kind" readonly="id" />
            <field name="solution_id" readonly="id" />
            <field name="active" />
          </group>
          <field name="revision_ids" readonly="1">
            <list>
              <field name="number" />
              <field name="title" />
              <field name="sealed" />
            </list>
          </field>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <record id="view_context_revision_list" model="ir.ui.view">
    <field name="name">solution.context.revision.list</field>
    <field name="model">project.agile.solution.context.revision</field>
    <field name="arch" type="xml">
      <list>
        <field name="context_id" />
        <field name="kind" />
        <field name="number" />
        <field name="title" />
        <field name="owner_id" />
        <field name="planning_significance" />
        <field name="resolution_status" />
        <field name="sealed" />
      </list>
    </field>
  </record>
  <record id="view_context_revision_form" model="ir.ui.view">
    <field name="name">solution.context.revision.form</field>
    <field name="model">project.agile.solution.context.revision</field>
    <field name="arch" type="xml">
      <form duplicate="0">
        <header>
          <button
            name="action_request_resolution"
            type="object"
            string="Record Resolution"
            invisible="sealed or kind != 'question' or resolution_status != 'open'"
            groups="project.group_project_manager,project_agile_solution.group_business_analyst"
          />
        </header>
        <sheet>
          <div
            class="alert alert-info"
            role="status"
          >Business actors, personas and domains describe the solution. They never create accounts or grant permissions. Decisions and discovery do not approve scope.</div>
          <group>
            <field name="context_id" readonly="id" />
            <field name="kind" />
            <field name="number" />
            <field name="predecessor_id" />
            <field name="sealed" />
            <field name="sequence" readonly="sealed" />
            <field name="title" readonly="sealed" />
            <field name="audience" readonly="sealed" />
            <field name="solution_id" invisible="1" />
            <field name="project_id" invisible="1" />
          </group>
          <field name="body" readonly="sealed" />
          <group invisible="kind != 'actor'">
            <field name="business_role" readonly="sealed" />
          </group>
          <group invisible="kind != 'deliverable'">
            <field name="evaluation_expectations" readonly="sealed" />
          </group>
          <group invisible="kind != 'question'">
            <field name="question" readonly="sealed" />
            <field name="owner_id" readonly="sealed" />
            <field name="external_owner" readonly="sealed" />
            <field name="planning_significance" readonly="sealed" />
            <field
              name="spike_task_ids"
              readonly="sealed"
              domain="[('project_id', '=', project_id), ('agile_item_type_id.code', '=', 'spike')]"
            />
            <field name="resolution_status" />
            <field name="resolution" />
            <field name="resolution_rationale" />
            <field name="resolved_by_id" />
            <field name="resolved_at" />
          </group>
          <group invisible="kind != 'decision'">
            <field name="decision_context" readonly="sealed" />
            <field name="choice" readonly="sealed" />
            <field name="consequences" readonly="sealed" />
          </group>
          <field
            name="affected_requirement_revision_ids"
            readonly="sealed"
            domain="[('solution_id', '=', solution_id)]"
          />
          <field name="document_revision_ids" readonly="1" />
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_question_resolution_wizard" model="ir.ui.view">
    <field name="name">solution.question.resolution.form</field>
    <field name="model">project.agile.solution.question.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="context_revision_id" readonly="1" />
          <field name="resolution" />
          <field name="rationale" />
        </group>
        <footer>
          <button
            name="action_confirm"
            type="object"
            string="Record Resolution"
            class="btn-primary"
          />
          <button special="cancel" string="Cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="view_solution_revision_content" model="ir.ui.view">
    <field name="name">solution.revision.exact.content</field>
    <field name="model">project.agile.solution.revision</field>
    <field name="inherit_id" ref="view_solution_revision_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Exact Requirements">
          <field
            name="requirement_revision_ids"
            readonly="state != 'draft'"
            domain="[('solution_id', '=', solution_id)]"
          />
        </page>
        <page string="Exact Supporting Context">
          <field
            name="context_revision_ids"
            readonly="state != 'draft'"
            domain="[('solution_id', '=', solution_id)]"
          />
        </page>
      </xpath>
    </field>
  </record>
  <record id="action_requirement" model="ir.actions.act_window">
    <field name="name">Requirements</field>
    <field name="res_model">project.agile.requirement</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_requirement_revision" model="ir.actions.act_window">
    <field name="name">Requirement Revisions</field>
    <field name="res_model">project.agile.requirement.revision</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_solution_context" model="ir.actions.act_window">
    <field name="name">Solution Supporting Context</field>
    <field name="res_model">project.agile.solution.context</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_solution_context_revision" model="ir.actions.act_window">
    <field name="name">Supporting Context Revisions</field>
    <field name="res_model">project.agile.solution.context.revision</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem
    id="menu_requirement"
    name="Requirements"
    parent="menu_solutions"
    action="action_requirement"
    groups="project.group_project_user"
    sequence="84"
  />
  <menuitem
    id="menu_requirement_revision"
    name="Requirement Revisions"
    parent="menu_solutions"
    action="action_requirement_revision"
    groups="project.group_project_user"
    sequence="85"
  />
  <menuitem
    id="menu_solution_context"
    name="Solution Supporting Context"
    parent="menu_solutions"
    action="action_solution_context"
    groups="project.group_project_user"
    sequence="86"
  />
  <menuitem
    id="menu_solution_context_revision"
    name="Context Revisions"
    parent="menu_solutions"
    action="action_solution_context_revision"
    groups="project.group_project_user"
    sequence="87"
  />
</odoo>
