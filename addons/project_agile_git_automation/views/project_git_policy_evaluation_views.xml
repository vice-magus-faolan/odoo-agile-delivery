<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_git_policy_evaluation_list" model="ir.ui.view">
        <field name="name">project.git.policy.evaluation.list</field>
        <field name="model">project.git.policy.evaluation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="evaluated_at"/><field name="repository_id"/><field name="agile_key"/>
                <field name="pull_request_id"/><field name="rule_id"/><field name="revision_id"/>
                <field name="outcome"/><field name="reason"/><field name="mode"/>
            </list>
        </field>
    </record>
    <record id="view_git_policy_evaluation_form" model="ir.ui.view">
        <field name="name">project.git.policy.evaluation.form</field>
        <field name="model">project.git.policy.evaluation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <p>Informational dry-run only. This decision never reserves an effect or authorizes a Task write.</p>
                    <group><field name="repository_id"/><field name="project_id"/><field name="company_id"/><field name="task_id"/><field name="agile_key"/><field name="pull_request_id"/></group>
                    <group><field name="rule_id"/><field name="activation_id"/><field name="revision_id"/><field name="outcome"/><field name="reason"/><field name="mode"/><field name="evaluated_at"/></group>
                    <group><field name="expected_stage_id"/><field name="expected_state"/><field name="expected_write_date"/><field name="snapshot_version"/><field name="fingerprint"/></group>
                    <field name="observation_ids"/>
                    <field name="snapshot_json"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_git_policy_observation_form" model="ir.ui.view">
        <field name="name">project.git.policy.observation.form</field>
        <field name="model">project.git.policy.observation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet>
                <group><field name="repository_id"/><field name="project_id"/><field name="company_id"/><field name="task_id"/><field name="agile_key"/><field name="provider_request_id"/><field name="observed_at"/><field name="snapshot_version"/><field name="fingerprint"/></group>
                <field name="snapshot_json"/>
            </sheet></form>
        </field>
    </record>
    <record id="action_git_policy_evaluations" model="ir.actions.act_window">
        <field name="name">Git Policy Dry Runs</field><field name="res_model">project.git.policy.evaluation</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_git_policy_evaluations" name="Git Policy Dry Runs" parent="project.menu_project_config" action="action_git_policy_evaluations" groups="project_agile_git_automation.group_git_policy_manager" sequence="82"/>
    <record id="view_git_repository_dry_run" model="ir.ui.view">
        <field name="name">project.git.repository.policy.dry.run</field><field name="model">project.git.repository</field>
        <field name="inherit_id" ref="project_agile_git.view_project_git_repository_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dry_run_git_policy" type="object" string="Evaluate Dry Run (20 PRs)" groups="project_agile_git_automation.group_git_policy_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
