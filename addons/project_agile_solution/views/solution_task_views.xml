<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_solution_task_intent_list" model="ir.ui.view">
    <field name="name">solution.task.intent.list</field>
    <field name="model">project.agile.solution.task.intent</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="operation" />
        <field name="solution_id" />
        <field name="state" />
        <field name="task_id" />
      </list>
    </field>
  </record>
  <record id="view_solution_task_intent_form" model="ir.ui.view">
    <field name="name">solution.task.intent.form</field>
    <field name="model">project.agile.solution.task.intent</field>
    <field name="arch" type="xml">
      <form string="Deliberate Task Preview">
        <header>
          <button
            name="action_request_confirmation"
            type="object"
            string="Review and Confirm"
            invisible="not id"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div
            class="alert alert-info"
            role="status"
          >Saving creates a preview only. Review and deliberately confirm to create/link work. No automatic estimates, Sprint allocation, criteria or workflow updates.</div>
          <group>
            <field name="solution_id" readonly="id" />
            <field name="operation" readonly="id" />
            <field
              name="requirement_revision_ids"
              widget="many2many_tags"
              readonly="id"
              domain="[('solution_id', '=', solution_id)]"
            />
            <field
              name="document_revision_id"
              readonly="id"
              domain="[('solution_id', '=', solution_id), ('kind', '=', 'spec')]"
            />
            <field
              name="task_id"
              readonly="id"
              invisible="operation == 'create' and state != 'consumed'"
              domain="[('project_id', '=', project_id)]"
            />
            <field name="project_id" invisible="1" />
            <field
              name="agile_item_type_id"
              readonly="id"
              invisible="operation != 'create'"
            />
            <field name="name" readonly="id" />
            <field name="description" readonly="id" invisible="operation != 'create'" />
            <field name="preview_text" invisible="not id" />
            <field name="creator_id" invisible="not id" />
            <field name="consumed_at" invisible="state != 'consumed'" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_solution_task_confirm_wizard" model="ir.ui.view">
    <field name="name">solution.task.confirm.wizard.form</field>
    <field name="model">project.agile.solution.task.confirm.wizard</field>
    <field name="arch" type="xml">
      <form string="Confirm Native Work">
        <group>
          <field name="intent_id" readonly="1" />
          <field name="operation" />
          <field name="name" />
          <field name="task_id" />
          <field name="description" />
          <field name="preview_text" />
        </group>
        <footer>
          <button
            name="action_confirm"
            type="object"
            string="Confirm This Preview"
            class="btn-primary"
          />
          <button string="Cancel" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="view_requirement_task_link_list" model="ir.ui.view">
    <field name="name">requirement.task.link.list</field>
    <field name="model">project.agile.requirement.task.link</field>
    <field name="arch" type="xml">
      <list create="false">
        <field name="requirement_revision_id" />
        <field name="task_id" />
        <field name="document_revision_id" />
        <field name="linked_by_id" />
        <field name="linked_at" />
        <field name="active" />
      </list>
    </field>
  </record>
  <record id="view_requirement_task_link_form" model="ir.ui.view">
    <field name="name">requirement.task.link.form</field>
    <field name="model">project.agile.requirement.task.link</field>
    <field name="arch" type="xml">
      <form create="false" edit="false">
        <sheet>
          <group>
            <field name="requirement_revision_id" />
            <field name="task_id" />
            <field name="document_revision_id" />
            <field name="active" />
            <field name="linked_at" />
            <field name="linked_by_id" />
            <field name="retired_at" />
            <field name="retired_by_id" />
            <field name="retirement_reason" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_requirement_task_retire_wizard" model="ir.ui.view">
    <field name="name">requirement.task.retire.wizard.form</field>
    <field name="model">project.agile.requirement.task.retire.wizard</field>
    <field name="arch" type="xml">
      <form string="Retire Working Coverage">
        <group>
          <field name="link_id" readonly="1" />
          <field name="reason" />
        </group>
        <footer>
          <button
            name="action_confirm"
            type="object"
            string="Retire With This Reason"
            class="btn-primary"
          />
          <button string="Cancel" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="view_requirement_task_retire_button" model="ir.ui.view">
    <field name="name">requirement.task.retire.button</field>
    <field name="model">project.agile.requirement.task.link</field>
    <field name="inherit_id" ref="view_requirement_task_link_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header>
          <button
            name="action_request_retirement"
            type="object"
            string="Retire Working Link"
            invisible="not active"
            groups="project.group_project_manager"
          />
        </header>
      </xpath>
    </field>
  </record>
  <record id="view_task_solution_maintenance" model="ir.ui.view">
    <field name="name">task.solution.maintenance</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='description_page']" position="after">
        <page string="Solution Maintenance">
          <field
            name="solution_maintenance_reason"
            placeholder="Optional reason this maintenance work has no requirement links."
          />
        </page>
      </xpath>
    </field>
  </record>
  <record id="action_solution_task_intent" model="ir.actions.act_window">
    <field name="name">Deliberate Task Previews</field>
    <field name="res_model">project.agile.solution.task.intent</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_requirement_task_link" model="ir.actions.act_window">
    <field name="name">Exact Requirement Work Links</field>
    <field name="res_model">project.agile.requirement.task.link</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem
    id="menu_solution_task_intent"
    name="Deliberate Task Previews"
    parent="project.menu_main_pm"
    action="action_solution_task_intent"
    groups="project.group_project_manager"
    sequence="88"
  />
  <menuitem
    id="menu_requirement_task_link"
    name="Requirement Work Links"
    parent="project.menu_main_pm"
    action="action_requirement_task_link"
    groups="project.group_project_user"
    sequence="89"
  />
</odoo>
