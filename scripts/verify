#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
WORKTREE_NAMESPACE=$(printf '%s' "$(basename "$ROOT")" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-')
# Always own a disposable project; never adopt an inherited development stack.
COMPOSE_PROJECT_NAME="odoo-agile-verify-${WORKTREE_NAMESPACE%-}-$$"
export COMPOSE_PROJECT_NAME
# Reuse one image tag per checkout, independently of disposable run projects.
VERIFY_IMAGE_TAG=$(printf '%s' "$ROOT" | sha256sum | cut -d ' ' -f 1)
export VERIFY_IMAGE_TAG
COMPOSE=(docker compose -p "$COMPOSE_PROJECT_NAME" -f compose.yaml -f compose.verify.yaml)
PRIOR_SOURCE_COMMITS=(898f0e105aed33aaeb6815fdc56edb10892f6165 2c974e580a436dacd9b526002f639e79fda544b1)
DATABASE_INSTALL=odoo_agile_verify_install
DATABASE_UPGRADE=odoo_agile_verify_upgrade
DATABASE_REINSTALL=odoo_agile_verify_reinstall
VERIFICATION_DATABASES=("$DATABASE_INSTALL" "$DATABASE_UPGRADE" "$DATABASE_REINSTALL")
# No arguments runs every supported suite.
# Analysis errors fall back to full; an invalid supported graph fails visibly.
SELECTION=$(python3 "$ROOT/scripts/ci_selection.py" --format lines "$@")
mapfile -t PLAN <<< "$SELECTION"
MODE=${PLAN[0]}
SELECTED=${PLAN[1]}
MODULES=${PLAN[2]}
printf "Verification mode: %s\nSelected standalone unit addons: %s\nReason: %s\nExcluded unavailable bridges: %s\n" "$MODE" "$SELECTED" "${PLAN[3]}" "${PLAN[4]:-}"
python3 -m unittest discover -s scripts/tests -v
if [[ $MODE == none ]]; then
    printf "%s\n" "Documentation-only changes; skipping Odoo verification."
    exit 0
fi


source "$ROOT/scripts/lib/compose-teardown.sh"

chmod a+r "$ROOT/config/odoo.conf"
chmod -R a+rX "$ROOT/addons"
# Public probes are bind-mounted and executed as the non-root Odoo user too.
chmod -R a+rX "$ROOT/scripts"
python3 -m compileall -q addons scripts
"${COMPOSE[@]}" build odoo

reset_verification_database() {
    local database=$1
    local configured_database

    for configured_database in "${VERIFICATION_DATABASES[@]}"; do
        if [[ $configured_database == "$database" ]]; then
            printf "%s\n" "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = :'database_name' AND pid <> pg_backend_pid();" \
                | "${COMPOSE[@]}" exec -T db psql -v ON_ERROR_STOP=1 -U odoo -d postgres \
                    -v database_name="$database"
            "${COMPOSE[@]}" exec -T db dropdb -U odoo --if-exists "$database"
            return
        fi
    done

    printf "Refusing to reset undeclared verification database: %s\n" "$database" >&2
    return 2
}

run_odoo() {
    "${COMPOSE[@]}" run --rm odoo odoo --config=/etc/odoo/odoo.conf --stop-after-init --without-demo=True --log-level test "$@"
}

# Select tests only in standalone registries, without testing every prerequisite.
run_unit_install() {
    local database=$1 modules=$2 module tags=""
    local -a suites
    IFS=, read -ra suites <<< "${3:-$modules}"
    for module in "${suites[@]}"; do
        if [[ ,$SELECTED, == *,"$module",* ]]; then
            tags+="${tags:+,}/$module"
        fi
    done
    if [[ -n $tags ]]; then
        printf "Native unit discovery: install=%s tags=%s\n" "$modules" "$tags"
        run_odoo --database "$database" --init "$modules" --test-enable --test-tags "$tags"
    else
        printf "No selected unit suites in standalone install: %s\n" "$modules"
        run_odoo --database "$database" --init "$modules"
    fi
}

uninstall_module() {
    local database=${2:-$DATABASE_REINSTALL}
    local output status=0
    output=$(mktemp)
    printf "%s\n" \
        "module = env[\"ir.module.module\"].search([(\"name\", \"=\", \"$1\")], limit=1)" \
        "module.button_immediate_uninstall()" \
        "env.cr.commit()" \
        | "${COMPOSE[@]}" run --rm -T odoo odoo shell --config=/etc/odoo/odoo.conf --database "$database" --no-http 2>&1 \
        | tee "$output" || status=$?
    # Odoo can log teardown SQL errors yet let its shell exit successfully.
    # Inspect only this uninstall, not expected negative-test diagnostics.
    if grep -Eq '(^|[[:space:]])ERROR[[:space:]]' "$output"; then
        printf 'Uninstall logged an ERROR: %s\n' "$1" >&2
        (( status != 0 )) || status=1
    fi
    rm -f "$output"
    return "$status"
}

solution_lifecycle() {
    local phase=$1
    { printf 'PHASE = "%s"\n' "$phase"; cat "$ROOT/scripts/probes/solution_lifecycle_probe.py"; } \
        | "${COMPOSE[@]}" run --rm -T odoo odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http
}

"${COMPOSE[@]}" up -d --wait db
for PRIOR_SOURCE_COMMIT in "${PRIOR_SOURCE_COMMITS[@]}"; do
    reset_verification_database "$DATABASE_UPGRADE"
    # Install each supported prior source into the same owned DB used for its update.
    (
        PRIOR_SOURCE_ROOT=$(mktemp -d)
        trap 'status=$?
        if ! rm -rf -- "$PRIOR_SOURCE_ROOT"; then
            printf "Prior-source cleanup failed: %s\n" "$PRIOR_SOURCE_ROOT" >&2
            (( status != 0 )) || status=1
        fi
        exit "$status"' EXIT
        printf "Owning temporary prior-source directory: %s\n" "$PRIOR_SOURCE_ROOT"
        git -C "$ROOT" archive "$PRIOR_SOURCE_COMMIT" addons | tar -x -C "$PRIOR_SOURCE_ROOT"
        chmod a+rx "$PRIOR_SOURCE_ROOT"
        chmod -R a+rX "$PRIOR_SOURCE_ROOT/addons"
        printf "Prior-source install: %s\n" "$PRIOR_SOURCE_COMMIT"
        "${COMPOSE[@]}" run --rm -v "$PRIOR_SOURCE_ROOT/addons:/mnt/extra-addons:ro" odoo \
            odoo --config=/etc/odoo/odoo.conf --stop-after-init --without-demo=True \
            --database "$DATABASE_UPGRADE" --init "$MODULES"
        { printf "PHASE = \"seed\"\n"; cat "$ROOT/scripts/probes/item_type_lifecycle_probe.py"; } | "${COMPOSE[@]}" run --rm -T -v "$PRIOR_SOURCE_ROOT/addons:/mnt/extra-addons:ro" odoo odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_UPGRADE" --no-http
    )
    printf "%s\n" "Prior-source population complete; updating the same database with candidate source."
    run_odoo --database "$DATABASE_UPGRADE" --update "$MODULES"
    { printf "PHASE = \"check\"\n"; cat "$ROOT/scripts/probes/item_type_lifecycle_probe.py"; } | "${COMPOSE[@]}" run --rm -T odoo odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_UPGRADE" --no-http
    printf "%s\n" "Upgrade smoke test passed for $MODULES from $PRIOR_SOURCE_COMMIT."
done
reset_verification_database "$DATABASE_INSTALL"
run_unit_install "$DATABASE_INSTALL" project_agile_git_automation
printf "%s\n" "Independent optional Git policy install passed (without GitHub or Scrum)."
reset_verification_database "$DATABASE_INSTALL"
run_unit_install "$DATABASE_INSTALL" project_agile_solution
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/probes/solution_concurrency_probe.py"
printf "%s\n" "Independent optional solution install passed (without Scrum, Git, Sales or document backend)."
solution_lifecycle seed_core
run_odoo --database "$DATABASE_INSTALL" --update project_agile_solution
solution_lifecycle check_core
uninstall_module project_agile_solution "$DATABASE_INSTALL"
solution_lifecycle removed_core
run_odoo --database "$DATABASE_INSTALL" --init project_agile_solution
solution_lifecycle reinstalled_core
printf "%s\n" "Independent solution persisted-data upgrade and uninstall/reinstall preserve native work; uninstall destroys solution history."
reset_verification_database "$DATABASE_INSTALL"
run_unit_install "$DATABASE_INSTALL" project_agile_solution_scrum project_agile_solution,project_agile_solution_scrum
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/probes/solution_scrum_probe.py"
printf "%s\n" "Independent optional solution Scrum bridge install and native relink/event races passed."
solution_lifecycle seed_bridge
run_odoo --database "$DATABASE_INSTALL" --update project_agile_solution,project_agile_solution_scrum
solution_lifecycle check_bridge
uninstall_module project_agile_solution_scrum "$DATABASE_INSTALL"
solution_lifecycle removed_bridge
run_odoo --database "$DATABASE_INSTALL" --init project_agile_solution_scrum --update project_agile_solution
solution_lifecycle reinstalled_bridge
printf "%s\n" "Independent bridge persisted-data upgrade and uninstall/reinstall preserve native history without fabricated backfill."
reset_verification_database "$DATABASE_INSTALL"
# All addons share this registry: unrelated addons can override the same model.
# The selector appends hr_timesheet for installation, not its upstream test suite.
COMBINED_ADDONS=${MODULES%,hr_timesheet}
TEST_TAGS=/${COMBINED_ADDONS//,/,/}
printf "Combined unit suites: %s\n" "$TEST_TAGS"
run_odoo --database "$DATABASE_INSTALL" --init "$MODULES" --test-enable --test-tags "$TEST_TAGS"
printf "%s\n" "Clean install passed for $MODULES."
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/probes/planning_concurrency_probe.py"
printf "%s\n" "Planning assign/return and reorder independent-process races passed."
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/probes/git_policy_concurrency_probe.py"
printf "%s\n" "Native Git policy scheduling, budget interruption, independent-process races and crash recovery passed."
"${COMPOSE[@]}" run --rm -T odoo \
    odoo shell --config=/etc/odoo/odoo.conf --database "$DATABASE_INSTALL" --no-http \
    < "$ROOT/scripts/probes/github_association_concurrency_probe.py"
printf "%s\n" "Current-delivery association proof and independent-process duplicate recovery passed."
reset_verification_database "$DATABASE_REINSTALL"
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES"
uninstall_module project_agile_solution_scrum
uninstall_module project_agile_solution
uninstall_module project_agile_git_automation
uninstall_module project_agile_git_github
uninstall_module project_agile_git
uninstall_module project_agile_ui
uninstall_module project_scrum_analytics
uninstall_module project_scrum
uninstall_module project_agile
uninstall_module hr_timesheet
run_odoo --database "$DATABASE_REINSTALL" --init "$MODULES"
printf "%s\n" "Uninstall/reinstall smoke test passed for $MODULES."
printf "%s\n" "Verification passed."
