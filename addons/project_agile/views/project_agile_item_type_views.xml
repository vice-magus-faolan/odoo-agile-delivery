<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_project_agile_item_type_list" model="ir.ui.view">
    <field name="name">project.agile.item.type.list</field>
    <field name="model">project.agile.item.type</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle" />
        <field name="name" />
        <field name="code" />
        <field name="active" />
        <field name="uses_story_points" />
      </list>
    </field>
  </record>

  <record id="view_project_agile_item_type_form" model="ir.ui.view">
    <field name="name">project.agile.item.type.form</field>
    <field name="model">project.agile.item.type</field>
    <field name="arch" type="xml">
      <form string="Agile Item Type">
        <sheet>
          <group>
            <field name="name" />
            <field name="code" />
            <field name="sequence" />
            <field name="active" />
            <field name="uses_story_points" />
          </group>
          <group string="Hierarchy Policy">
            <field name="allowed_child_type_ids" widget="many2many_tags" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_project_agile_item_type" model="ir.actions.act_window">
    <field name="name">Agile Item Types</field>
    <field name="res_model">project.agile.item.type</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_project_agile_item_type_list" />
  </record>

  <menuitem
    id="menu_project_agile_item_type"
    name="Agile Item Types"
    parent="project.menu_project_config"
    action="action_project_agile_item_type"
    groups="project.group_project_manager"
    sequence="30"
  />
</odoo>
