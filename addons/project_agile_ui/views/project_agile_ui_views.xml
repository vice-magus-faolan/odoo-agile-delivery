<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_project_form_agile_planning" model="ir.ui.view">
    <field name="name">project.project.form.agile.planning</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project" />
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <field name="agile_enabled" invisible="1" />
        <button
          name="action_open_agile_roadmap"
          type="object"
          class="oe_stat_button"
          icon="fa-calendar"
          groups="project.group_project_user"
          invisible="not agile_enabled or not active or is_template"
        >
          <div class="o_stat_info">
            <span class="o_stat_text">Roadmap</span>
          </div>
        </button>
        <button
          name="action_open_agile_planning"
          type="object"
          class="oe_stat_button"
          icon="fa-list-alt"
          groups="project.group_project_user"
          invisible="not agile_enabled or not active or is_template"
        >
          <div class="o_stat_info">
            <span class="o_stat_text">Sprint Planning</span>
          </div>
        </button>
        <button
          name="action_open_agile_swimlanes"
          type="object"
          class="oe_stat_button"
          icon="fa-table"
          groups="project.group_project_user"
          invisible="not agile_enabled or not active or is_template"
        >
          <div class="o_stat_info">
            <span class="o_stat_text">Active Sprint board</span>
          </div>
        </button>
      </xpath>
      <xpath expr="//sheet/notebook" position="inside">
        <page
          string="Advisory WIP"
          name="agile_wip"
          groups="project.group_project_manager"
          invisible="not agile_enabled"
        >
          <group>
            <field name="agile_wip_enabled" />
          </group>
          <p
          >Limits only warn on the Active Sprint board. They never block Task changes.</p>
          <p
          >Counts cover your visible open work in the selected Project, team and Active Sprint scope, across all pages and lanes. Hidden work is not counted.</p>
          <field
            name="agile_wip_limit_ids"
            context="{&quot;default_project_id&quot;: id}"
          >
            <list editable="bottom">
              <field name="project_id" column_invisible="True" />
              <field
                name="stage_id"
                domain="[(&quot;project_ids&quot;, &quot;in&quot;, [parent.id])]"
                options="{&quot;no_create&quot;: True}"
              />
              <field name="limit" />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
  <record id="view_task_list_roadmap" model="ir.ui.view">
    <field name="name">project.task.list.roadmap</field>
    <field name="model">project.task</field>
    <field name="arch" type="xml">
      <list
        string="Roadmap work"
        create="false"
        edit="false"
        delete="false"
        default_order="date_deadline, id"
      >
        <field name="agile_key" />
        <field name="name" />
        <field name="project_id" />
        <field name="parent_id" optional="show" />
        <field name="agile_item_type_id" />
        <field name="agile_team_id" />
        <field
          name="milestone_id"
          groups="project.group_project_milestone"
          optional="show"
        />
        <field name="date_deadline" />
      </list>
    </field>
  </record>
</odoo>
