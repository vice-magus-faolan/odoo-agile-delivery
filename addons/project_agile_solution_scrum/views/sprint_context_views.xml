<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_sprint_solution_capture" model="ir.ui.view">
    <field name="name">sprint.solution.capture</field>
    <field name="model">project.sprint</field>
    <field name="inherit_id" ref="project_scrum.view_project_sprint_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='scope_event_ids']/list/field[@name='event_type']"
        position="after"
      >
        <field name="solution_capture_status" />
        <button
          name="action_open_solution_context"
          type="object"
          string="Exact Requirements"
          icon="fa-link"
        />
      </xpath>
    </field>
  </record>
  <record id="view_solution_sprint_context_list" model="ir.ui.view">
    <field name="name">solution.sprint.context.list</field>
    <field name="model">project.agile.solution.sprint.context</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="scope_event_id" />
        <field name="task_id" />
        <field name="requirement_revision_id" />
        <field name="document_revision_id" />
      </list>
    </field>
  </record>
  <record id="view_solution_sprint_context_form" model="ir.ui.view">
    <field name="name">solution.sprint.context.form</field>
    <field name="model">project.agile.solution.sprint.context</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <div
            class="alert alert-info"
            role="status"
          >Exact observed requirement context at this native event. Sprint commitment is not specification approval or requirement acceptance.</div>
          <group>
            <field name="scope_event_id" />
            <field name="task_id" />
            <field name="requirement_revision_id" />
            <field name="document_revision_id" />
          </group>
          <group string="Frozen Observed Content and Approval State">
            <field name="payload_json" nolabel="1" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
