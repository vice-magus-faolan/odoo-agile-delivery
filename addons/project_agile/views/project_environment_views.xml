<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_project_environment_settings" model="ir.ui.view">
    <field name="name">project.project.environment.settings</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="view_project_form_agile" />
    <field name="arch" type="xml">
      <field name="agile_estimation_method" position="after">
        <field name="agile_environment_ids" context="{'active_test': False}">
          <list editable="bottom">
            <field name="sequence" widget="handle" />
            <field name="name" />
            <field name="is_production" />
            <field name="active" />
          </list>
        </field>
      </field>
    </field>
  </record>
  <record id="view_item_type_environment_list" model="ir.ui.view">
    <field name="name">project.agile.item.type.environment.list</field>
    <field name="model">project.agile.item.type</field>
    <field name="inherit_id" ref="view_project_agile_item_type_list" />
    <field name="arch" type="xml">
      <field name="uses_story_points" position="after">
        <field name="tracks_environments" />
      </field>
    </field>
  </record>
  <record id="view_item_type_environment_form" model="ir.ui.view">
    <field name="name">project.agile.item.type.environment.form</field>
    <field name="model">project.agile.item.type</field>
    <field name="inherit_id" ref="view_project_agile_item_type_form" />
    <field name="arch" type="xml">
      <field name="uses_story_points" position="after">
        <field name="tracks_environments" />
      </field>
    </field>
  </record>
  <record id="view_task_environment_form" model="ir.ui.view">
    <field name="name">project.task.environment.form</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="view_task_form_agile" />
    <field name="arch" type="xml">
      <page name="agile" position="inside">
        <field name="agile_tracks_environments" invisible="1" />
        <group string="Environments" invisible="not agile_tracks_environments">
          <field
            name="agile_environment_status_ids"
            domain="[('applicable', '=', True)]"
            nolabel="1"
          >
            <list editable="bottom" create="0" delete="0" open_form_view="1">
              <field name="environment_id" readonly="1" />
              <field name="status" />
              <field name="actor_id" readonly="1" />
              <field name="changed_at" readonly="1" />
            </list>
          </field>
          <button
            name="action_environment_history"
            type="object"
            string="Environment history"
            class="btn-link"
          />
        </group>
      </page>
    </field>
  </record>
  <record id="view_task_environment_search" model="ir.ui.view">
    <field name="name">project.task.environment.search</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="view_task_search_agile" />
    <field name="arch" type="xml">
      <field name="agile_item_type_id" position="after">
        <!-- Typed raw_value is the name (self); a selected suggestion is an ID. -->
        <field
          name="agile_done_environment_id"
          filter_domain="[('agile_done_environment_id', '=ilike' if raw_value == self else '=', raw_value)]"
        />
        <field
          name="agile_pending_environment_id"
          filter_domain="[('agile_pending_environment_id', '=ilike' if raw_value == self else '=', raw_value)]"
        />
        <separator />
        <filter
          name="agile_waiting_for_production"
          string="Waiting for Production"
          domain="[('agile_waiting_for_production', '=', True)]"
        />
      </field>
    </field>
  </record>
  <record id="view_task_environment_status_list" model="ir.ui.view">
    <field name="name">project.task.environment.status.list</field>
    <field name="model">project.task.environment.status</field>
    <field name="arch" type="xml">
      <list create="0" delete="0">
        <field name="task_id" />
        <field name="environment_id" />
        <field name="status" />
        <field name="actor_id" />
        <field name="changed_at" />
        <field name="applicable" />
      </list>
    </field>
  </record>
  <record id="view_task_environment_status_form" model="ir.ui.view">
    <field name="name">project.task.environment.status.form</field>
    <field name="model">project.task.environment.status</field>
    <field name="arch" type="xml">
      <form create="0" delete="0" duplicate="0">
        <sheet>
          <group>
            <field name="task_id" readonly="1" />
            <field name="environment_id" readonly="1" />
            <field name="applicable" readonly="1" />
            <field name="status" readonly="not applicable" />
            <field name="actor_id" readonly="1" />
            <field name="changed_at" readonly="1" />
          </group>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
</odoo>
